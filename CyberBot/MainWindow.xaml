<Window x:Class="CyberBotWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberBot"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#424769">

    <Window.Resources>
        
        <!-- SEND BUTTON STYLE -->
        <Style x:Key="ChatbotButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#95B2C4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            
                        </Border>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            
        </Style>
        
    </Window.Resources>
    
    <!--MAIN GRID-->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>
        
        <!--ASCII HEADER-->
        <Border Grid.Row="0"
                Background="#424769"
                BorderBrush="#30363D"
                BorderThickness="0,0,0,1">

            <Grid>
                <TextBox x:Name="LogoTextBox"
                         Background="White"
                         BorderThickness="0"
                         Foreground="#95B2C4"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Grid>
            
        </Border>
        
        <!--CHAT AREA-->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <ListBox x:Name="ChatListBox"
                     Background="#424769"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="15"
                     Margin="15">

                <ListBox.ItemContainerStyle>

                    <Style TargetType="ListBoxItem">

                        <Setter Property="Margin" Value="0,8"/>
                        
                    </Style>
                    
                </ListBox.ItemContainerStyle>
                
            </ListBox>
            
        </ScrollViewer>
        
        <!--INPUT AREA-->
        <Border Grid.Row="2"
                Background="#424769"
                BorderThickness="1,1,0,0">

            <Grid Margin="15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                
                <!--MESSAGE INPUT-->
                <Border Background="#AFBCC5"
                        CornerRadius="15"
                        BorderBrush="#30363D"
                        BorderThickness="1"
                        Margin="0,0,15,0">

                    <TextBox x:Name="MessageTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="15"
                             Padding="15"
                             CaretBrush="White"
                             VerticalContentAlignment="Center"
                             KeyDown="MessageTextBox_KeyDown"/>

                </Border>
                
                <!--SEND BUTTON-->
                <Button Grid.Column="1"
                        Content="Send"
                        Style="{StaticResource ChatbotButtonStyle}"
                        Click="Button_Click"/>

            </Grid>
        </Border>
        
    </Grid>
    
</Window>
